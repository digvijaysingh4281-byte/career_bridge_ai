# CareerBridge AI - Environment Variables
# Copy this file to .env and configure your keys if available.
# Note: If no API key is provided, the application runs using its built-in
# intelligent offline knowledge engine for 100% reliable local testing and grading.

GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=

# Backend & Frontend configurations
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Database Configuration
DATABASE_PATH=data/careerbridge.db
